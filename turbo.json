{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalEnv": ["CI", "QRONOS_DISABLE_SHARE"],
  "globalPassThroughEnv": ["CI", "QRONOS_DISABLE_SHARE"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    },
    "@qronos-ai/cli#build": {
      "dependsOn": ["@qronos-ai/sdk#build"],
      "outputs": ["dist/**"]
    },
    "@qronos-ai/cli#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": ["*"]
    },
    "test:ci": {
      "outputs": [".artifacts/unit/junit.xml"],
      "passThroughEnv": ["*"]
    },
    "@qronos-ai/core#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@qronos-ai/function#test": {
      "outputs": []
    },
    "@qronos-ai/cli#test:ci": {
      "dependsOn": ["^build"],
      "env": ["QRONOS_TEST_PROFILE", "QRONOS_TEST_SHARD"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.github/workflows/test.yml"],
      "outputs": [".artifacts/unit/junit.xml"],
      "passThroughEnv": ["*"]
    },
    "@qronos-ai/cli#test:httpapi": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["*"]
    },
    "@qronos-ai/gateway#test:ci": {
      "outputs": [".artifacts/unit/junit.xml"]
    },
    "@qronos-ai/docs#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**"],
      "env": ["POSTHOG_API_KEY", "FREE_TIER_AMOUNT", "NEXT_PUBLIC_POSTHOG_KEY", "NEXT_PUBLIC_POSTHOG_HOST"]
    },
    "@qronos-ai/jetbrains#build": {
      "dependsOn": ["@qronos-ai/cli#build"],
      "outputs": ["build/distributions/**"]
    },
    "@qronos-ai/jetbrains#typecheck": {
      "outputs": []
    },
    "@qronos-ai/jetbrains#test:ci": {
      "outputs": [".artifacts/unit/junit.xml"]
    },
    "@qronos-ai/ui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@qronos-ai/session-ui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@qronos-ai/ui#test:ci": {
      "dependsOn": ["^build"],
      "outputs": [".artifacts/unit/junit.xml"],
      "passThroughEnv": ["*"]
    }
  }
}
